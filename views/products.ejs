<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>OliveMe - 전체 제품</title>
    <link rel="stylesheet" href="/style.css">
    <style>
    body {
        background-color: #f8fbe9;
        font-family: 'Apple SD Gothic Neo', sans-serif;
    }
    .container {
        max-width: 1000px;
        margin: auto;
        padding: 20px;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    .card {
        background-color: #fdfaf4;
        border: 1px solid #dbe4c6;
        border-radius: 16px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        padding: 20px;
        text-align: center;
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-3px);
    }
    .card img {
        width: 100px;
        height: 100px;
        object-fit: contain;
        margin-bottom: 10px;
    }
    .card-name {
        font-size: 16px;
        color: #333;
        margin: 8px 0;
        cursor: pointer;
    }
    .card-price {
        font-size: 14px;
        color: #666;
        margin-bottom: 12px;
    }
    .add-btn {
        background-color: #b9df9f;
        border: none;
        padding: 8px 16px;
        border-radius: 20px;
        color: #fff;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .add-btn:hover {
        background-color: #a6ce8f;
    }
    header {
        text-align: center;
        margin-bottom: 30px;
    }
    </style>
</head>
<body>
    <header>
    <h1>🌿 OliveMe 전체 제품 보기 페이지입니다 🌿</h1>
    <% if (session.username) { %>
        <p><strong><%= session.username %></strong>님, 안녕하세요 😊</p>
        <a href="/logout"><button>로그아웃</button></a>
        <a href="/cart"><button>장바구니</button></a>
    <% } else { %>
        <a href="/login"><button>로그인</button></a>
        <a href="/register"><button>회원가입</button></a>
    <% } %>
    <a href="/recommend"><button>🌤️ 오늘의 화장품 추천</button></a>
    </header>

    <div class="container">
    <h2>🛍️ Oliveme 전체 제품</h2>

    <% if (products && products.length > 0) { %>
        <div class="grid">
        <% products.forEach(product => { %>
            <div class="card">
            <img src="/img/lipstick.png" alt="상품 이미지">
            <div class="card-name" onclick="location.href='/product/<%= product.id %>'">
                <%= product.name %>
            </div>
            <div class="card-price"><%= product.price.toLocaleString() %>원</div>
            <form action="/cart/add" method="POST">
                <input type="hidden" name="id" value="<%= product.id %>">
                <input type="hidden" name="quantity" value="1">
                <button class="add-btn" type="submit">🛒 담기</button>
            </form>
            </div>
        <% }) %>
        </div>
    <% } else { %>
        <p>상품이 없습니다.</p>
    <% } %>
    </div>
</body>
</html>
