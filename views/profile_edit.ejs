<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>개인정보 수정 - OliveMe</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    body {
      background-color: #f5f0e6;
      font-family: 'Apple SD Gothic Neo', sans-serif;
      margin: 0;
    }

    .profile-edit-box {
      width: 420px;
      margin: 80px auto;
      background-color: #fdfaf4;
      border: 1px solid #dbe4c6;
      border-radius: 16px;
      padding: 35px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    h2 {
      text-align: center;
      color: #2e3b2e;
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      color: #444;
      font-weight: bold;
    }

    input {
      width: 100%;
      padding: 10px;
      border: 1px solid #dbe4c6;
      border-radius: 10px;
      margin-bottom: 16px;
      box-sizing: border-box;
      font-size: 14px;
    }

    .readonly {
      background-color: #eee;
      color: #666;
    }

    .success {
      color: green;
      text-align: center;
      margin-bottom: 15px;
      font-size: 14px;
    }

    .error {
      color: red;
      text-align: center;
      margin-bottom: 15px;
      font-size: 14px;
    }

    .message {
      color: #2e3b2e;
      text-align: center;
      margin-top: -6px;
      margin-bottom: 14px;
      font-size: 13px;
      line-height: 1.5;
    }

    .email-auth-box {
      display: none;
      margin-top: -6px;
      margin-bottom: 12px;
    }

    .email-auth-box.active {
      display: block;
    }

    .email-auth-row {
      display: flex;
      gap: 6px;
      align-items: center;
      margin-bottom: 10px;
    }

    .email-auth-row input {
      margin-bottom: 0;
      flex: 1;
    }

    .btn-area {
      text-align: center;
      margin-top: 10px;
    }

    button {
      background-color: #b9df9f;
      color: white;
      border: none;
      padding: 9px 18px;
      border-radius: 20px;
      font-weight: bold;
      cursor: pointer;
      margin: 3px;
    }

    button:hover {
      background-color: #a6ce8f;
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .small-btn {
      padding: 8px 12px;
      font-size: 13px;
      white-space: nowrap;
      border-radius: 16px;
    }

    .back-btn {
      background-color: #ccc;
    }

    .back-btn:hover {
      background-color: #aaa;
    }
  </style>
</head>

<body>
  <div class="profile-edit-box">
    <h2>🔐 개인정보 수정</h2>

    <% if (success) { %>
      <div class="success"><%= success %></div>
    <% } %>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <div id="emailMessage" class="message"></div>

    <form action="/profile-edit" method="POST">
      <label for="username">아이디</label>
      <input 
        type="text" 
        id="username" 
        value="<%= user.username %>" 
        class="readonly"
        readonly
      >

      <label for="name">이름</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        value="<%= user.name || '' %>" 
        placeholder="이름 입력"
      >

      <label for="phone">전화번호</label>
      <input 
        type="text" 
        id="phone" 
        name="phone" 
        value="<%= user.phone || '' %>" 
        placeholder="010-0000-0000"
      >

      <label for="email">이메일</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        value="<%= user.email || '' %>" 
        data-original-email="<%= user.email || '' %>"
        oninput="checkEmailChanged()"
        required
      >

      <div id="emailAuthBox" class="email-auth-box">
        <button type="button" class="small-btn" id="sendEmailCodeBtn" onclick="sendProfileEmailCode()">
          이메일 인증번호 받기
        </button>

        <div class="email-auth-row">
          <input 
            type="text" 
            id="profileEmailCode" 
            placeholder="인증번호 6자리" 
            maxlength="6"
          >
          <button type="button" class="small-btn" id="verifyEmailCodeBtn" onclick="verifyProfileEmailCode()">
            인증확인
          </button>
        </div>
      </div>

      <div class="btn-area">
        <button type="submit">수정하기</button>
        <button type="button" class="back-btn" onclick="location.href='/mypage'">돌아가기</button>
      </div>
    </form>
  </div>

  <script>
    let emailVerified = false;

    function checkEmailChanged() {
      const emailInput = document.getElementById("email");
      const emailAuthBox = document.getElementById("emailAuthBox");
      const emailMessage = document.getElementById("emailMessage");
      const originalEmail = emailInput.dataset.originalEmail;
      const currentEmail = emailInput.value.trim();

      if (currentEmail && currentEmail !== originalEmail) {
        emailAuthBox.classList.add("active");
        emailVerified = false;
        emailMessage.style.color = "#2e3b2e";
        emailMessage.textContent = "이메일을 변경하려면 새 이메일 인증을 진행해주세요.";
      } else {
        emailAuthBox.classList.remove("active");
        emailVerified = true;
        emailMessage.textContent = "";
      }
    }

    async function sendProfileEmailCode() {
      const email = document.getElementById("email").value.trim();
      const message = document.getElementById("emailMessage");
      const sendBtn = document.getElementById("sendEmailCodeBtn");

      if (!email) {
        message.style.color = "red";
        message.textContent = "이메일을 입력해주세요.";
        return;
      }

      sendBtn.disabled = true;
      message.style.color = "#2e3b2e";
      message.textContent = "인증번호를 전송 중입니다...";

      try {
        const response = await fetch("/profile-edit/send-code", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ email })
        });

        const data = await response.json();

        if (data.success) {
          message.style.color = "#2e3b2e";
          message.textContent = data.message;
        } else {
          message.style.color = "red";
          message.textContent = data.message || "인증번호 전송에 실패했습니다.";
        }
      } catch (err) {
        message.style.color = "red";
        message.textContent = "인증번호 전송 중 오류가 발생했습니다.";
      }

      setTimeout(function () {
        sendBtn.disabled = false;
      }, 3000);
    }

    async function verifyProfileEmailCode() {
      const email = document.getElementById("email").value.trim();
      const code = document.getElementById("profileEmailCode").value.trim();
      const message = document.getElementById("emailMessage");

      if (!email || !code) {
        message.style.color = "red";
        message.textContent = "이메일과 인증번호를 모두 입력해주세요.";
        return;
      }

      try {
        const response = await fetch("/profile-edit/verify-code", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ email, code })
        });

        const data = await response.json();

        if (data.success) {
          emailVerified = true;
          message.style.color = "#2e3b2e";
          message.textContent = data.message;
        } else {
          emailVerified = false;
          message.style.color = "red";
          message.textContent = data.message || "인증번호가 일치하지 않습니다.";
        }
      } catch (err) {
        emailVerified = false;
        message.style.color = "red";
        message.textContent = "이메일 인증 확인 중 오류가 발생했습니다.";
      }
    }

    checkEmailChanged();
  </script>
</body>
</html>