<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>제품 수정</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    body {
      background-color: #f5f0e6;
      font-family: 'Apple SD Gothic Neo', sans-serif;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 50px auto;
      padding: 30px;
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    h1 {
      margin-bottom: 20px;
      color: #2e3b2e;
      text-align: center;
    }
    label {
      display: block;
      margin: 15px 0 5px;
      font-weight: bold;
      color: #4caf50;
    }
    input[type="text"], input[type="number"], textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 12px;
      font-size: 16px;
      box-sizing: border-box;
    }
    textarea {
      resize: vertical;
      min-height: 100px;
    }
    button {
      margin-top: 30px;
      width: 100%;
      padding: 14px;
      background-color: #b9df9f;
      border: none;
      border-radius: 25px;
      color: white;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.2s;
      font-size: 18px;
    }
    button:hover {
      background-color: #a6ce8f;
    }
    a.back-btn {
      display: block;
      margin-top: 15px;
      text-align: center;
      color: #555;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>제품 수정</h1>
    <form action="/admin/edit/<%= product.id %>" method="POST">
      <label for="name">제품명</label>
      <input type="text" id="name" name="name" value="<%= product.name %>" required />

      <label for="price">가격 (원)</label>
      <input type="number" id="price" name="price" value="<%= product.price %>" required min="0" />

      <label for="image">이미지 파일명</label>
      <input type="text" id="image" name="image" value="<%= product.image %>" required />

      <label for="description">제품 설명</label>
      <textarea id="description" name="description"><%= product.description %></textarea>

      <button type="submit">수정 완료</button>
    </form>
    <a href="/admin" class="back-btn">← 제품 목록으로 돌아가기</a>
  </div>
</body>
</html>
